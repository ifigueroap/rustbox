{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Local shell UI. Child service webviews are not listed here, so they do not inherit these commands.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-state",
    "allow-add-service",
    "allow-update-service",
    "allow-remove-service",
    "allow-reorder-services",
    "allow-focus-service",
    "allow-reload-service",
    "allow-set-content-bounds",
    "allow-set-services-visible"
  ]
}
