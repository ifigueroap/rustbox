{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shell UI. Service pages do not inherit these permissions.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-list-presets",
    "allow-add-preset",
    "allow-add-custom",
    "allow-update-service",
    "allow-remove-service",
    "allow-reorder-services",
    "allow-set-active-service",
    "allow-set-sidebar-collapsed",
    "allow-set-service-sound",
    "allow-set-service-notifications",
    "allow-set-service-notify-in-dnd",
    "allow-set-hibernation-settings",
    "allow-set-service-never-hibernate",
    "allow-set-service-permission",
    "allow-answer-permission",
    "allow-set-do-not-disturb",
    "allow-set-dnd-schedule",
    "allow-set-close-to-tray",
    "allow-set-start-at-login",
    "allow-set-start-hidden",
    "allow-quit-app",
    "allow-import-local-icon",
    "allow-read-local-icon",
    "allow-set-theme",
    "allow-set-language",
    "allow-set-ui-locale",
    "allow-add-workspace",
    "allow-update-workspace",
    "allow-include-services",
    "allow-set-workspace-dnd",
    "allow-remove-workspace",
    "allow-set-active-workspace",
    "allow-move-workspace",
    "allow-reorder-workspaces",
    "allow-set-workspace-rail-hidden",
    "allow-apply-service-shortcut",
    "allow-set-find-open",
    "allow-find-in-service",
    "allow-reset-service-zoom",
    "allow-reload-service",
    "allow-maintain-service",
    "allow-set-service-spellcheck",
    "allow-open-external",
    "allow-check-for-updates",
    "allow-set-update-auto-check",
    "allow-skip-update",
    "allow-install-update",
    "allow-relaunch-app",
    "allow-export-config",
    "allow-prepare-config-import",
    "allow-apply-config-import"
  ]
}
