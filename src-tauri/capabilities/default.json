{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shell UI. Service pages do not inherit these permissions.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-list-presets",
    "allow-add-preset",
    "allow-add-custom",
    "allow-update-service",
    "allow-remove-service",
    "allow-reorder-services",
    "allow-set-active-service"
  ]
}
