{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustbox",
  "version": "0.7.0",
  "identifier": "app.rustbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rustbox",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#141210",
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Host multiple web apps in one window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NTZBOEEzQTc4NTgxQUYKUldTdmdZV25vNmhXOWQ2QjErNlVjSTluOVdJNFJrdVl3YTJNdFJRVHlYSXpxTTc2d09uQy9uNngK",
      "endpoints": [
        "https://github.com/ifigueroap/rustbox/releases/latest/download/latest.json"
      ]
    }
  }
}
